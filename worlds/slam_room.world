    <!-- 드론 카메라: 원점 상공 8m, 수직 하방 -->
    <!-- spartina_world.world 에서 그대로 이식. 토픽 /drone/image_raw -->
    <model name="drone_camera">
      <static>true</static>
      <pose>0 0 8 0 1.5708 0</pose>
      <link name="camera_link">
        <visual name="visual">
          <geometry><box><size>0.2 0.2 0.1</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.8 1</ambient>
            <diffuse>0.1 0.1 0.9 1</diffuse>
          </material>
        </visual>
        <sensor type="camera" name="drone_camera_sensor">
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
          <plugin name="drone_camera_controller" filename="libgazebo_ros_camera.so">
            <camera_name>drone</camera_name>
            <frame_name>drone_camera_optical</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
